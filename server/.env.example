# Copy to .env beside compose.yaml. Compose loads it into the shyd container.
# A variable already set in the shell wins. Leave a line commented to keep the default.
# The database stays on the shy-data volume at /data/shy.db.

# Base URL of the dashboard, as visitors reach it through Caddy.
# Default: http://127.0.0.1:8080
SHY_PUBLIC_URL=http://127.0.0.1:8080

# Upstream key for POST /v1/chat/completions. Empty rejects model calls.
# The default root is OpenRouter's OpenAI-compatible API.
SHY_OPENAI_API_KEY=
# SHY_OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Neatlogs project key. Empty stores traces and does not forward them.
# An nlw_ write key also needs SHY_NEATLOGS_PROJECT_NAME.
SHY_NEATLOGS_API_KEY=
SHY_NEATLOGS_PROJECT_NAME=

# Default: https://ingest.neatlogs.com
# SHY_NEATLOGS_INGEST_URL=https://ingest.neatlogs.com

# Max trace and chat body in bytes (1024–52428800). Default: 8388608
# SHY_BODY_LIMIT=8388608
